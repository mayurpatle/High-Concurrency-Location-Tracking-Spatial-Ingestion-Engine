          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"driverId\": \"driver-001\", \"lat\": "
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
