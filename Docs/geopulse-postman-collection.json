{
  "info": {
    "name": "GeoPulse — Location Ingestion Engine",
    "description": "API tests for the High-Concurrency Location Tracking & Spatial Ingestion Engine.\n\nCovers everything built through Phase 2:\n- Health checks (ingestion + processing)\n- Happy path ingestion (202 Accepted)\n- Validation failures (including the Double-vs-double trap)\n- The accuracy quality gate (accept-and-discard)\n- Batch ingestion + size cap\n- H3 spatial debug endpoints (hierarchy + k-ring math)\n- Dedup scenario (requires manual Redis verification)\n\nRun the whole collection with the Collection Runner. Every request has assertions.\n\nPREREQUISITES:\n  docker compose up -d\n  mvn spring-boot:run -pl ingestion-service    (port 8081)\n  mvn spring-boot:run -pl processing-service   (port 8082)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ingestionUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "processingUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "dedupTimestamp",
      "value": "1719900016000",
      "type": "string",
      "description": "FIXED on purpose — the dedup key is driverId+timestamp, so both sends must share it."
    }
  ],
  "item": [
    {
      "name": "00 — Health",
      "item": [
        {
          "name": "Ingestion service health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ingestionUrl}}/actuator/health",
              "host": ["{{ingestionUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is UP', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});",
                  "// NOTE: no kafka component here — Spring Boot ships no default",
                  "// Kafka health indicator. The producer path is proven in kafka-ui."
                ]
              }
            }
          ]
        },
        {
          "name": "Processing service health (Redis + Cassandra)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{processingUrl}}/actuator/health",
              "host": ["{{processingUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is UP', () => pm.expect(body.status).to.eql('UP'));",
                  "pm.test('redis is UP', () => {",
                  "    pm.expect(body.components.redis.status).to.eql('UP');",
                  "});",
                  "pm.test('cassandra is UP', () => {",
                  "    pm.expect(body.components.cassandra.status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 — Happy path",
      "item": [
        {
          "name": "Valid ping (Bandra, Mumbai)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh millis timestamp so repeated runs are NOT deduped.",
                  "pm.collectionVariables.set('nowMillis', Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 Accepted — not 200 OK', () => {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "pm.test('body is empty (status code IS the response)', () => {",
                  "    pm.expect(pm.response.text().trim()).to.eql('');",
                  "});",
                  "pm.test('responds under 50ms (p99 SLO)', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(50);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"driver-001\",\n  \"lat\": 19.0596,\n  \"lng\": 72.8295,\n  \"timestamp\": {{nowMillis}},\n  \"speed\": 12.5,\n  \"heading\": 270.0,\n  \"accuracy\": 5.0\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        },
        {
          "name": "Valid ping — optional fields omitted",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('nowMillis', Date.now());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('202 — speed/heading/accuracy are OPTIONAL', () => {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "// Regression guard: an absent accuracy once caused an NPE via",
                  "// auto-unboxing (request.accuracy().doubleValue()). Absent != bad."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"driver-002\",\n  \"lat\": 19.1136,\n  \"lng\": 72.8697,\n  \"timestamp\": {{nowMillis}}\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        }
      ]
    },
    {
      "name": "02 — Validation failures",
      "item": [
        {
          "name": "MISSING lat — the Double-vs-double trap",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('names the offending field', () => {",
                  "    pm.expect(body.fields.lat).to.include('required');",
                  "});",
                  "pm.test('no stack trace leaked', () => {",
                  "    pm.expect(pm.response.text()).to.not.include('Exception');",
                  "    pm.expect(pm.response.text()).to.not.include('com.geopulse');",
                  "});",
                  "// THE POINT: with a primitive `double lat`, Jackson would default",
                  "// this to 0.0 — a VALID latitude (Gulf of Guinea) — and it would",
                  "// pass range validation as a real location. Silent corruption.",
                  "// The Double wrapper stays null so @NotNull can catch it."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"driver-001\",\n  \"lng\": 72.8295,\n  \"timestamp\": 1719900000000\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        },
        {
          "name": "lat out of range (200.0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('range bound reported', () => {",
                  "    pm.expect(pm.response.json().fields.lat).to.include('90');",
                  "});",
                  "// Different code path from @NotNull — this is @DecimalMax."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"driver-001\",\n  \"lat\": 200.0,\n  \"lng\": 72.8295,\n  \"timestamp\": 1719900000000\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        },
        {
          "name": "lng out of range (-500.0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('lng flagged', () => {",
                  "    pm.expect(pm.response.json().fields).to.have.property('lng');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"driver-001\",\n  \"lat\": 19.0596,\n  \"lng\": -500.0,\n  \"timestamp\": 1719900000000\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        },
        {
          "name": "blank driverId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('driverId flagged', () => {",
                  "    pm.expect(pm.response.json().fields).to.have.property('driverId');",
                  "});",
                  "// @NotBlank rejects null, \"\" AND \"   \" — a ping without a",
                  "// driver is meaningless."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"   \",\n  \"lat\": 19.0596,\n  \"lng\": 72.8295,\n  \"timestamp\": 1719900000000\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        },
        {
          "name": "negative speed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('speed flagged', () => {",
                  "    pm.expect(pm.response.json().fields).to.have.property('speed');",
                  "});",
                  "// Optional fields are still VALIDATED when present."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"driver-001\",\n  \"lat\": 19.0596,\n  \"lng\": 72.8295,\n  \"timestamp\": 1719900000000,\n  \"speed\": -5.0\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        },
        {
          "name": "heading > 360",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('heading flagged', () => {",
                  "    pm.expect(pm.response.json().fields).to.have.property('heading');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"driver-001\",\n  \"lat\": 19.0596,\n  \"lng\": 72.8295,\n  \"timestamp\": 1719900000000,\n  \"heading\": 400.0\n}"
            },
            "url": {
              "raw": "{{ingestionUrl}}/v1/locations",
              "host": ["{{ingestionUrl}}"],
              "path": ["v1", "locations"]
            }
          }
        },
        {
          "name": "malformed JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('generic message — parser internals NOT echoed', () => {",
                  "    pm.expect(pm.response.json().error).to.include('Malformed');",
                  "    pm.expect(pm.response.text()).to.not.include('Jackson');",
                  "});",
                  "// Handled by HttpMessageNotReadableException, not @Valid."
