<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.geopulse</groupId>
        <artifactId>geopulse</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>geopulse-ingestion-service</artifactId>
    <packaging>jar</packaging>
    <name>geopulse-ingestion-service</name>
    <description>Write path: REST ingest -> H3 encode -> Kafka producer</description>

    <dependencies>
        <!-- Our shared code. Version comes from the parent's
             dependencyManagement, so no <version> needed. -->
        <dependency>
            <groupId>com.geopulse</groupId>
            <artifactId>geopulse-common</artifactId>
        </dependency>

        <!-- REST endpoint + embedded Tomcat. This IS the ingest API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Hibernate Validator: the RUNTIME that enforces the @NotNull/@Min
             annotations we declared on the DTOs over in common. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Kafka support. Ingestion only PRODUCES messages. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Actuator: /actuator/health + metrics. Used in the Part 5 smoke
             test and again in Phase 6 observability. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- THIS is what makes the module an executable Spring Boot app:
                 it repackages into a runnable "fat jar" and enables
                 `mvn spring-boot:run`. common deliberately does NOT have it. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>