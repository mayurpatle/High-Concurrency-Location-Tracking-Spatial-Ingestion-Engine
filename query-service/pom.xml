<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.geopulse</groupId>
        <artifactId>geopulse</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>geopulse-query-service</artifactId>
    <packaging>jar</packaging>
    <name>geopulse-query-service</name>
    <description>Read path: nearby + presence (Redis) and trajectory (Cassandra)</description>

    <dependencies>
        <dependency>
            <groupId>com.geopulse</groupId>
            <artifactId>geopulse-common</artifactId>
        </dependency>

        <!-- REST read APIs (/v1/drivers/nearby, /v1/drivers/{id}/trajectory...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Read current location + "nearby" from the hot tier. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Read trajectory/occupancy history from the cold tier. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-cassandra</artifactId>
        </dependency>

        <!-- No spring-kafka here — query never touches the bus. -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>