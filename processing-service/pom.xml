<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.geopulse</groupId>
        <artifactId>geopulse</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>geopulse-processing-service</artifactId>
    <packaging>jar</packaging>
    <name>geopulse-processing-service</name>
    <description>Consumer: Kafka -> dedupe -> Redis (hot) + Cassandra (history)</description>

    <dependencies>
        <dependency>
            <groupId>com.geopulse</groupId>
            <artifactId>geopulse-common</artifactId>
        </dependency>

        <!-- Kafka support. Processing only CONSUMES. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Redis client (Lettuce under the hood). The hot-state write path. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Cassandra client. The history write path. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-cassandra</artifactId>
        </dependency>

        <!-- NOTE: web is here ONLY so Actuator can serve /actuator/health and
             readiness/liveness probes over HTTP (K8s requirement). This
             service exposes NO business endpoints — it's a headless worker. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>